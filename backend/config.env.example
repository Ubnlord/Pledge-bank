# PLEDGE BANK backend configuration template
# Copy into a private local environment file only after choosing a dedicated project.
# Do not put secret/service-role keys in public/ or any browser-accessible bundle.
NODE_ENV=development
PORT=8080
# Configure only after a dedicated PLEDGE BANK Supabase project exists:
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret, if a trusted backend workflow requires it. Never expose to browser.
SUPABASE_SECRET_KEY=
# Comma-separated exact origins allowed by the eventual API; set per deployment.
ALLOWED_ORIGINS=http://localhost:8080
